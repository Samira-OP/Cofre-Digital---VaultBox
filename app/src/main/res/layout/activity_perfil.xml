<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnVoltarPerfil"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logout"
                android:rotation="180"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Perfil do Colaborador"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Avatar e Nome -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/escudoapp_telainicial"
            android:contentDescription="Avatar Colaborador"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtPerfilNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carlos Andrade"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPerfilFuncaoTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_category"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ADMINISTRADOR GERAL"
            android:textColor="@color/purple_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Card de Informações do Perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <!-- E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail Corporativo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="admgeral@vaultbox.com"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Cargo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilCargo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrador Geral de Sistemas"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Departamento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Departamento"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilDepartamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geral (Todos os Setores)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Permissão / Perfil -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nível de Acesso no VaultBox"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilNivelAcesso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrador Geral (Controle Total + Gestão de Usuários)"
                android:textColor="@color/purple_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botão de Gestão de Usuários (Apenas Admin Geral) -->
        <Button
            android:id="@+id/btnGestaoUsuarios"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚙️ GESTÃO DE COLABORADORES"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_primary"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Botão Sair da Conta -->
        <Button
            android:id="@+id/btnSairPerfil"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ENCERRAR SESSÃO"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="#FF6B6B" />

    </LinearLayout>

</ScrollView>
