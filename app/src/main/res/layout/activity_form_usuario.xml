<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/escudoapp_telainicial"
                android:scaleType="fitCenter"
                android:contentDescription="Escudo do VaultBox"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VaultBox"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CADASTRO DE COLABORADORES"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Card do Formulário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/txtTituloFormUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastrar Novo Colaborador"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preencha os dados abaixo para conceder acesso ao VaultBox."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <!-- Nome -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Completo *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtNomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: Carlos Andrade"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail Corporativo *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtEmailUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: colaborador@vaultbox.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha Inicial *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtSenhaUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Digite a senha de acesso"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Cargo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo / Função *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtCargoUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: Analista de TI, Gerente de RH..."
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Setor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setor / Departamento *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spnSetorUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Perfil -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil / Nível de Permissão *"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spnPerfilUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="24dp" />

            <!-- Botões -->
            <Button
                android:id="@+id/btnSalvarUsuario"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SALVAR COLABORADOR"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/purple_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCancelarUsuario"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="CANCELAR"
                android:textColor="@color/text_secondary"
                android:backgroundTint="#302747" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
