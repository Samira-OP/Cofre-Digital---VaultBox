<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Identidade do aplicativo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <!-- Imagem do escudo -->
            <ImageView
                android:id="@+id/imgEscudo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/escudoapp_telainicial"
                android:scaleType="fitCenter"
                android:contentDescription="Escudo do VaultBox"
                android:layout_marginEnd="10dp" />

            <!-- Nome do aplicativo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VaultBox"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GESTÃO CORPORATIVA DE CREDENCIAIS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="24dp" />

        <!-- Card de login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acesso Corporativo"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entre com suas credenciais para acessar os cofres do seu departamento."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <!-- Campo de e-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail Corporativo"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="ex: admgeral@vaultbox.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp" />

            <!-- Área da senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/purple_secondary"
                android:padding="10dp" />

            <!-- Recuperação de senha -->
            <TextView
                android:id="@+id/txtRecuperarSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esqueceu sua senha?"
                android:textColor="@color/purple_secondary"
                android:textSize="13sp"
                android:gravity="end"
                android:layout_marginTop="12dp" />

            <!-- Botão entrar -->
            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ACESSAR COFRE"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/purple_primary"
                android:layout_marginTop="20dp" />

            <!-- Acesso ao cadastro -->
            <TextView
                android:id="@+id/txtCadastrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Novo colaborador? Cadastre-se aqui"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="18dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
